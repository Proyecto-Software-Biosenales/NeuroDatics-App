{
  "name": "app",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "npm run typecheck && npm run test:unit && npm run test:browser",
    "test:unit": "node --test \"features/**/*.test.mjs\"",
    "test:browser": "node --test tests/hooks/*.test.mjs tests/components/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:comparison": "playwright test tests/e2e/comparison-dashboard.spec.ts",
    "capture:manual": "playwright test -c playwright.manual.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.4.2",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^4.0.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
