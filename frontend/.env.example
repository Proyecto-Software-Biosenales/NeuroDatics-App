# NeuroDatics Frontend - Environment Variables
# Copy this file to frontend/.env.local for local Next.js development.
# Do not commit real secrets.

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
# Local dev usually calls the backend directly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-side Next.js rewrites. In local dev this points to the backend host;
# in Docker Compose the root .env uses http://backend:8000.
NEXT_INTERNAL_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=