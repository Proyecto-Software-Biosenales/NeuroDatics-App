# NeuroDatics Frontend - Environment Variables
# Copy this file to frontend/.env.local for local Next.js development.
# Do not commit real secrets.

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
# The browser calls /api on the same origin. Next.js rewrites those requests to
# this internal backend URL.
NEXT_INTERNAL_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Optional frontend-only dev shortcut
# ---------------------------------------------------------------------------
# This creates a local UI session only. It does not authenticate protected API
# calls and is not used by the Docker distribution flow.
NEXT_PUBLIC_DEV_ADMIN_EMAIL=
NEXT_PUBLIC_DEV_ADMIN_PASSWORD=
NEXT_PUBLIC_DEV_ADMIN_DISPLAY_NAME=Administrador NeuroDatics
