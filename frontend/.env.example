# ─────────────────────────────────────────────────────────────
# NeuroDatics Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.
# ─────────────────────────────────────────────────────────────

# ── Backend API ───────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Google OAuth ──────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Dev Admin (optional — local development only) ─────────────
# These enable a local admin login bypass without Google OAuth.
# NEXT_PUBLIC_DEV_ADMIN_EMAIL=admin@neurodatics.dev
# NEXT_PUBLIC_DEV_ADMIN_PASSWORD=12345678
# NEXT_PUBLIC_DEV_ADMIN_DISPLAY_NAME=Administrador NeuroDatics
