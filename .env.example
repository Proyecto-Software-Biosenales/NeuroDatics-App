# NeuroDatics Docker Compose environment
# Copy this file to ".env" in the repository root before starting Docker.
# Do not commit your real ".env" file.

# ---------------------------------------------------------------------------
# App port
# ---------------------------------------------------------------------------
# The main app will be available at http://localhost:3000 by default.
# Change this only if port 3000 is already in use.
FRONTEND_PORT=3000

# ---------------------------------------------------------------------------
# Docker internal URLs
# ---------------------------------------------------------------------------
# Keep NEXT_PUBLIC_API_BASE_URL empty in Docker so the browser calls /api on
# the same origin and Next.js proxies requests to the backend container.
NEXT_PUBLIC_API_BASE_URL=
NEXT_INTERNAL_API_BASE_URL=http://backend:8000

# ---------------------------------------------------------------------------
# PostgreSQL inside Docker
# ---------------------------------------------------------------------------
POSTGRES_DB=neurodatics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/neurodatics

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Use a long random value for real usage. For local testing, any long text works.
AUTH_JWT_SECRET=change-this-neurodatics-local-secret-before-sharing
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=neurodatics-backend
AUTH_ACCESS_TOKEN_EXP_MINUTES=20160

# ---------------------------------------------------------------------------
# Google OAuth login
# ---------------------------------------------------------------------------
# Required for real login. Create these in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/authorize
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# ---------------------------------------------------------------------------
# Google Drive integration
# ---------------------------------------------------------------------------
# Optional for first boot, required for project ZIP ingestion and Drive sync.
GDRIVE_FOLDER_ID=
GDRIVE_REFRESH_TOKEN=
GDRIVE_HTTP_TIMEOUT_SECONDS=300
GDRIVE_REQUEST_RETRIES=5
GOOGLE_APPLICATION_CREDENTIALS=
GDRIVE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Optional local frontend-only login helper
# ---------------------------------------------------------------------------
# This bypass is for UI development only. It does not provide a backend bearer
# token, so it is not a complete replacement for Google OAuth.
# NEXT_PUBLIC_DEV_ADMIN_EMAIL=admin@neurodatics.dev
# NEXT_PUBLIC_DEV_ADMIN_PASSWORD=change-me
# NEXT_PUBLIC_DEV_ADMIN_DISPLAY_NAME=Administrador NeuroDatics

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
APP_NAME=NeuroDatics API
DEBUG=false
