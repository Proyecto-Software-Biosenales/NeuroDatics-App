# NeuroDatics Docker Compose environment
# Copy this file to ".env" in the repository root before starting Docker.
# Do not commit your real ".env" file.

# ---------------------------------------------------------------------------
# App ports
# ---------------------------------------------------------------------------
# The app will be available at http://localhost:3000 by default.
FRONTEND_PORT=3000

# All browser requests, including large ZIP uploads, use the frontend's
# same-origin /api proxy. The FastAPI port stays private inside Docker.
APP_ENV=production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# PostgreSQL / Redis inside Docker
# ---------------------------------------------------------------------------
POSTGRES_DB=neurodatics
POSTGRES_USER=postgres
# Required even when DATABASE_URL is external because the current Compose stack
# also starts its isolated PostgreSQL service. Use a unique URL-safe secret.
POSTGRES_PASSWORD=
# Leave blank to use the internal PostgreSQL service with POSTGRES_PASSWORD.
# Set a complete URL here when using an external database.
DATABASE_URL=
REDIS_URL=redis://redis:6379

# For an external PostgreSQL/Supabase database in production, keep the
# provider-issued host and add TLS explicitly, for example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# ---------------------------------------------------------------------------
# Auth JWT
# ---------------------------------------------------------------------------
# Required. Replace this placeholder with a unique random value of 32+ chars.
# Production containers refuse known placeholders and short values.
AUTH_JWT_SECRET=replace-this-with-a-unique-random-secret-of-at-least-32-characters

# ---------------------------------------------------------------------------
# Google OAuth login
# ---------------------------------------------------------------------------
# Required for real use. The frontend asks the backend for the Google login URL,
# so no NEXT_PUBLIC_GOOGLE_CLIENT_ID is needed.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/authorize

# ---------------------------------------------------------------------------
# Google Drive integration
# ---------------------------------------------------------------------------
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback
GDRIVE_FOLDER_ID=
GDRIVE_REFRESH_TOKEN=
GDRIVE_HTTP_TIMEOUT_SECONDS=300
GDRIVE_REQUEST_RETRIES=5

# ---------------------------------------------------------------------------
# Project ingestion / processing
# ---------------------------------------------------------------------------
PROJECT_ZIP_MAX_SIZE_MB=500
INGESTION_SAVE_ORIGINAL_ZIP=true
JOB_TIMEOUT=3600
JOB_RESULT_TTL=86400

# ---------------------------------------------------------------------------
# Cache and local data paths inside Docker
# ---------------------------------------------------------------------------
AUTH_USER_STORE_PATH=/data/auth_users.json
PARQUET_CACHE_DIR=/data/parquet_cache
PARQUET_CACHE_TTL_HOURS=4
ANALYTICS_REDIS_TTL_SECONDS=900
IMAGE_CACHE_DIR=/data/image_cache
VIDEO_CACHE_DIR=/data/video_cache
VIDEO_FRAME_CACHE_DIR=/data/video_frame_cache

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME=NeuroDatics API
DEBUG=false

# ---------------------------------------------------------------------------
# Optional university/corporate proxy for backend and worker outbound HTTPS.
# PostgreSQL still needs an approved direct TCP route to DATABASE_URL's port.
# ---------------------------------------------------------------------------
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,frontend,backend,worker,db,redis
