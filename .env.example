# NeuroDatics en red (Docker Compose). Sin uso actual: NeuroDatics se entrega como aplicación local
# para Windows, que no lee este archivo. Sirve para quien quiera alojar la edición en red por su cuenta:
# docs/tecnica/alojamiento-en-red.md explica cada pieza.
#
# Copia este archivo a ".env" en la raíz del repositorio antes de iniciar Docker y no subas tu ".env".
# Lo marcado «DEBES PROVEER» queda vacío a propósito: lo rellena quien aloja la aplicación.

# ===========================================================================
# DEBES PROVEER: base de datos (PostgreSQL 16)
# ===========================================================================
# Opción A, el PostgreSQL del Compose: deja DATABASE_URL vacío y define POSTGRES_PASSWORD.
# Opción B, una base alojada (Supabase u otra): escribe la URL completa con TLS explícito, por ejemplo
#   DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Las tablas (proyectos, cuentas en app_users, autorización de Drive en system_integrations) se crean
# solas con las migraciones al arrancar.
DATABASE_URL=
POSTGRES_DB=neurodatics
POSTGRES_USER=postgres
# Obligatorio también con la opción B: el Compose siempre levanta su PostgreSQL. Usa un secreto único
# que pueda ir en una URL.
POSTGRES_PASSWORD=

# ===========================================================================
# DEBES PROVEER: identificación (Google OAuth + JWT propio)
# ===========================================================================
# Cliente OAuth web de Google Cloud: deployment/CONFIGURACION-GOOGLE.md. El frontend pide al backend la
# URL de inicio de sesión, así que no hace falta NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Cámbialo a https://<tu-dominio>/authorize y regístralo igual en Google Cloud.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/authorize
# Secreto con el que el backend firma las sesiones: aleatorio, único y de 32 caracteres o más.
# En producción se rechazan los valores de ejemplo y los cortos.
AUTH_JWT_SECRET=
# Cuentas de Google que pueden entrar, separadas por comas (da igual mayúsculas o minúsculas).
# Cualquier otra recibe 403 y no se registra. Vacío: puede entrar cualquier cuenta de Google.
AUTH_ALLOWED_EMAILS=

# ===========================================================================
# DEBES PROVEER: almacenamiento de archivos (Google Drive)
# ===========================================================================
# Usa el mismo cliente OAuth de arriba. La cuenta de Drive la conecta una vez quien administra, desde el
# servidor (deployment/scripts/conectar-drive.ps1). Otro almacenamiento exige código:
# backend/src/neurodatics/modules/integrations/storage_provider.py.
# Cámbialo a https://<tu-dominio>/api/integrations/google-drive/callback y regístralo en Google Cloud.
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback
# Carpeta raíz de Drive donde se guardan los proyectos. Vacío: la raíz de la cuenta conectada.
GDRIVE_FOLDER_ID=
GDRIVE_HTTP_TIMEOUT_SECONDS=300
GDRIVE_REQUEST_RETRIES=5
GDRIVE_UPLOAD_CONCURRENCY=4

# ===========================================================================
# DEBES PROVEER: dirección pública
# ===========================================================================
# La interfaz queda en http://localhost:<FRONTEND_PORT>. Ponle delante un proxy inverso con HTTPS y
# escribe aquí ese origen exacto (por ejemplo https://neurodatics.universidad.edu).
FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Caché (Redis del Compose; no hace falta cambiarlo)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=3

# ---------------------------------------------------------------------------
# Red interna de Docker
# ---------------------------------------------------------------------------
APP_ENV=production
# El navegador solo habla con la interfaz, que reenvía /api al backend por esta dirección interna.
# El puerto de FastAPI nunca se publica.
NEXT_INTERNAL_API_BASE_URL=http://backend:8000

# ---------------------------------------------------------------------------
# Subida y procesamiento de proyectos
# ---------------------------------------------------------------------------
PROJECT_ZIP_MAX_SIZE_MB=500
INGESTION_SAVE_ORIGINAL_ZIP=false

# Protección contra ZIP que se expanden sin límite y llenan el volumen /data.
PROJECT_ZIP_MAX_UNCOMPRESSED_MB=2000
PROJECT_ZIP_MAX_ENTRY_UNCOMPRESSED_MB=600
PROJECT_ZIP_MAX_ENTRIES=20000
PROJECT_ZIP_MAX_COMPRESSION_RATIO=100

# Cuántas subidas a la vez. El procesamiento ocurre en el backend y consume mucha memoria.
UPLOAD_MAX_CONCURRENT_PER_USER=1
UPLOAD_MAX_CONCURRENT_GLOBAL=4
UPLOAD_MIN_SECONDS_BETWEEN_UPLOADS=5
# Procesos por CSV durante el procesamiento. 0: la mitad de los CPU del contenedor, dentro de
# BACKEND_MEM_LIMIT repartido entre UPLOAD_MAX_CONCURRENT_GLOBAL subidas. 1: ninguno extra.
INGESTION_BLOCK_WORKERS=0

# Límites de memoria del contenedor del backend.
BACKEND_MEM_LIMIT=2g
BACKEND_MEM_RESERVATION=512m

# ---------------------------------------------------------------------------
# Cachés en disco dentro de Docker
# ---------------------------------------------------------------------------
PARQUET_CACHE_DIR=/data/parquet_cache
PARQUET_CACHE_TTL_HOURS=4
ANALYTICS_REDIS_TTL_SECONDS=900
IMAGE_CACHE_DIR=/data/image_cache
VIDEO_CACHE_DIR=/data/video_cache
VIDEO_FRAME_CACHE_DIR=/data/video_frame_cache
VIDEO_ONSET_CACHE_TTL_SECONDS=300
VIDEO_ONSET_CACHE_MAX_ITEMS=1024
VIDEO_DURATION_CACHE_TTL_SECONDS=3600
VIDEO_DURATION_CACHE_MAX_ITEMS=256

# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
APP_NAME=NeuroDatics API
DEBUG=false

# ---------------------------------------------------------------------------
# Proxy de salida de una universidad o empresa (solo si la red lo exige)
# ---------------------------------------------------------------------------
# PostgreSQL no pasa por HTTPS_PROXY: necesita una ruta TCP directa al puerto de DATABASE_URL.
# Ver docs/tecnica/despliegue-en-red.md.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,frontend,backend,db,redis
