+from neurodatics.modules.analytics.domain.parquet_projection import (
+    ParquetProjection, GSR_PROJECTION, PUPIL_PROJECTION, DISTANCE_PROJECTION,
+    TIMING_PROJECTION, EEG_PROJECTION,
