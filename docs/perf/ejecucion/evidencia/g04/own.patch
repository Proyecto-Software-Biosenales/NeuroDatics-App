+    flight = SingleFlight(max_running=1)
+    started, release = threading.Event(), threading.Event()
+    done = asyncio.Event()
+
+    def worker():
+        started.set()
+        assert release.wait(2)
+
+    async def request():
+        with anyio.CancelScope() as scope:
+            scopes.append(scope)
+            try:
+                await flight.run("a", lambda: settled_thread(worker))
+            finally:
+                done.set()
