--- /dev/null
+++ b/docs/perf/ejecucion/evidencia/g11/comandos.md
@@ -0,0 +1,22 @@
+# Comandos G11
+
+Ejecutados desde la raíz salvo indicación:
+
+```powershell
+$env:G11_VARIANT='base'
+$env:G11_OUTPUT="$PWD/docs/perf/ejecucion/evidencia/g11/profile-base-fresh.json"
+node docs/perf/ejecucion/evidencia/g11/benchmark_topography.mjs
+
+$env:G11_VARIANT='candidate'
+$env:G11_OUTPUT="$PWD/docs/perf/ejecucion/evidencia/g11/profile-candidate.json"
+node docs/perf/ejecucion/evidencia/g11/benchmark_topography.mjs
+
+node docs/perf/ejecucion/evidencia/g11/summarize_topography.mjs
+node --check docs/perf/ejecucion/evidencia/g11/benchmark_topography.mjs
+node --check docs/perf/ejecucion/evidencia/g11/summarize_topography.mjs
+
+cd frontend
+node --test features/analytics/eegPresentation.test.mjs
+```
+
+La prueba dirigida se ejecutó con los helpers reales del candidato antes de retirarlo; el log conserva los 20 casos verdes. Al final se comparan SHA-256 contra `output/perf-g11/base`, se verifica preservación, se genera `own.patch` y se ejecuta `git apply --reverse --check` sin modificar el checkout.
diff --git a/docs/perf/ejecucion/evidencia/g11/verify_preservation.ps1 b/docs/perf/ejecucion/evidencia/g11/verify_preservation.ps1
new file mode 100644
index 0000000..581c77f
--- /dev/null
+++ b/docs/perf/ejecucion/evidencia/g11/verify_preservation.ps1
@@ -0,0 +1,44 @@
+$ErrorActionPreference = "Stop"
+$repo = (Resolve-Path (Join-Path $PSScriptRoot "../../../../..")).Path
+$inventory = Get-Content -Raw -LiteralPath (Join-Path $PSScriptRoot "inventario-inicial.json") | ConvertFrom-Json
+$allowed = @(
+  "docs/CHANGELOG.md",
+  "docs/perf/ejecucion/ESTADO.md"
+)
+$unchanged = [Collections.Generic.List[string]]::new()
+$allowedChanged = [Collections.Generic.List[string]]::new()
+$missing = [Collections.Generic.List[string]]::new()
+$drift = [Collections.Generic.List[object]]::new()
+foreach ($record in $inventory.files) {
+  $path = [string]$record.path
+  $absolute = Join-Path $repo $path
+  if (-not (Test-Path -LiteralPath $absolute -PathType Leaf)) {
+    $missing.Add($path)
+    continue
+  }
+  $actual = (Get-FileHash -Algorithm SHA256 -LiteralPath $absolute).Hash.ToLowerInvariant()
+  if ($actual -eq [string]$record.sha256) {
+    $unchanged.Add($path)
+  } elseif ($allowed -contains $path) {
+    $allowedChanged.Add($path)
+  } else {
+    $drift.Add([ordered]@{ path = $path; expected = $record.sha256; actual = $actual })
+  }
+}
+$document = [ordered]@{
+  generated_at = [DateTime]::UtcNow.ToString("o")
+  received_protected = $inventory.files.Count
+  unchanged = $unchanged.Count
+  allowed_changed = @($allowedChanged | Sort-Object)
+  missing = @($missing | Sort-Object)
+  unexpected_drift = @($drift | Sort-Object path)
+  ok = $missing.Count -eq 0 -and $drift.Count -eq 0 -and $allowedChanged.Count -eq $allowed.Count
+  exclusions_in_received_inventory = $inventory.excludes
+}
+[IO.File]::WriteAllText(
+  (Join-Path $PSScriptRoot "preservacion.json"),
+  (($document | ConvertTo-Json -Depth 6) + "`n"),
+  [Text.UTF8Encoding]::new($false)
+)
+if (-not $document.ok) { throw "G11 preservation check failed" }
+Write-Output "preserved=$($unchanged.Count) allowed_changed=$($allowedChanged.Count)"
diff --git a/docs/perf/ejecucion/evidencia/g11/build_own_patch.ps1 b/docs/perf/ejecucion/evidencia/g11/build_own_patch.ps1
new file mode 100644
index 0000000..f75aa1b
--- /dev/null
+++ b/docs/perf/ejecucion/evidencia/g11/build_own_patch.ps1
@@ -0,0 +1,36 @@
+$ErrorActionPreference = "Stop"
+$repo = (Resolve-Path (Join-Path $PSScriptRoot "../../../../..")).Path
+$base = Join-Path $repo "output/perf-g11/base"
+$output = Join-Path $PSScriptRoot "own.patch"
+$paths = @(
+  "docs/CHANGELOG.md",
+  "docs/perf/ejecucion/ESTADO.md",
+  "docs/perf/ejecucion/G11.md",
+  "docs/perf/ejecucion/evidencia/g11/benchmark_topography.mjs",
+  "docs/perf/ejecucion/evidencia/g11/summarize_topography.mjs",
+  "docs/perf/ejecucion/evidencia/g11/comandos.md",
+  "docs/perf/ejecucion/evidencia/g11/verify_preservation.ps1",
+  "docs/perf/ejecucion/evidencia/g11/build_own_patch.ps1",
+  "docs/perf/ejecucion/evidencia/g11/build_manifest.ps1"
+)
+$chunks = [Collections.Generic.List[string]]::new()
+Push-Location $repo
+try {
+  foreach ($path in $paths) {
+    $received = Join-Path $base $path
+    if (Test-Path -LiteralPath $received -PathType Leaf) {
+      $receivedRelative = "output/perf-g11/base/$path"
+      $lines = & git diff --no-index --binary -- $receivedRelative $path
+      if ($LASTEXITCODE -notin 0, 1) { throw "git diff failed for $path" }
+      $text = ($lines -join "`n") -replace "a/output/perf-g11/base/", "a/"
+    } else {
+      $lines = & git diff --no-index --binary -- NUL $path
+      if ($LASTEXITCODE -notin 0, 1) { throw "git diff failed for new $path" }
+      $text = $lines -join "`n"
+    }
+    if ($text) { $chunks.Add($text) }
+  }
+} finally {
+  Pop-Location
+}
+[IO.File]::WriteAllText($output, (($chunks -join "`n") + "`n"), [Text.UTF8Encoding]::new($false))
diff --git a/docs/perf/ejecucion/evidencia/g11/build_manifest.ps1 b/docs/perf/ejecucion/evidencia/g11/build_manifest.ps1
new file mode 100644
index 0000000..d308426
--- /dev/null
+++ b/docs/perf/ejecucion/evidencia/g11/build_manifest.ps1
@@ -0,0 +1,61 @@
+$ErrorActionPreference = "Stop"
+$repo = (Resolve-Path (Join-Path $PSScriptRoot "../../../../..")).Path
+$spec = @(
+  @("docs/CHANGELOG.md", "documentation"),
+  @("docs/perf/ejecucion/ESTADO.md", "coordination-status"),
+  @("docs/perf/ejecucion/G11.md", "delivery"),
+  @("docs/perf/ejecucion/evidencia/g11/benchmark_topography.mjs", "benchmark-probe"),
+  @("docs/perf/ejecucion/evidencia/g11/summarize_topography.mjs", "measurement-reducer"),
+  @("docs/perf/ejecucion/evidencia/g11/profile-base.json", "preliminary-measurement"),
+  @("docs/perf/ejecucion/evidencia/g11/profile-base-fresh.json", "base-measurement"),
+  @("docs/perf/ejecucion/evidencia/g11/profile-candidate.json", "candidate-measurement"),
+  @("docs/perf/ejecucion/evidencia/g11/measurement-summary.json", "measurement-summary"),
+  @("docs/perf/ejecucion/evidencia/g11/profile-base.log", "benchmark-log"),
+  @("docs/perf/ejecucion/evidencia/g11/profile-base-fresh.log", "benchmark-log"),
+  @("docs/perf/ejecucion/evidencia/g11/profile-candidate.log", "benchmark-log"),
+  @("docs/perf/ejecucion/evidencia/g11/summary.log", "check-log"),
+  @("docs/perf/ejecucion/evidencia/g11/probe-check.log", "check-log"),
+  @("docs/perf/ejecucion/evidencia/g11/presentation-tests.log", "candidate-equivalence-log"),
+  @("docs/perf/ejecucion/evidencia/g11/inventario-inicial.json", "received-inventory"),
+  @("docs/perf/ejecucion/evidencia/g11/snapshot-scope.json", "received-snapshot"),
+  @("docs/perf/ejecucion/evidencia/g11/git-status-inicial.txt", "received-status"),
+  @("docs/perf/ejecucion/evidencia/g11/source-restoration.json", "restoration-check"),
+  @("docs/perf/ejecucion/evidencia/g11/preservacion.json", "preservation"),
+  @("docs/perf/ejecucion/evidencia/g11/preservation.log", "check-log"),
+  @("docs/perf/ejecucion/evidencia/g11/verificacion.json", "verification"),
+  @("docs/perf/ejecucion/evidencia/g11/comandos.md", "reproduction"),
+  @("docs/perf/ejecucion/evidencia/g11/verify_preservation.ps1", "reproduction"),
+  @("docs/perf/ejecucion/evidencia/g11/build_own_patch.ps1", "reproduction"),
+  @("docs/perf/ejecucion/evidencia/g11/build_manifest.ps1", "reproduction"),
+  @("docs/perf/ejecucion/evidencia/g11/own.patch", "patch"),
+  @("docs/perf/ejecucion/evidencia/g11/patch-reverse-check.log", "check-log")
+)
+$entries = foreach ($item in $spec) {
+  $relative = $item[0]
+  $absolute = Join-Path $repo $relative
+  if (-not (Test-Path -LiteralPath $absolute -PathType Leaf)) { throw "Missing manifest file: $relative" }
+  [ordered]@{
+    path = $relative
+    bytes = (Get-Item -LiteralPath $absolute).Length
+    sha256 = (Get-FileHash -Algorithm SHA256 -LiteralPath $absolute).Hash.ToLowerInvariant()
+    role = $item[1]
+  }
+}
+$document = [ordered]@{
+  generated_at = [DateTime]::UtcNow.ToString("o")
+  head = (git -C $repo rev-parse HEAD)
+  entry_count = $entries.Count
+  entries = $entries
+  exclusions = @(
+    "manifiesto-final.json self",
+    "ORQUESTACION/ASIGNACION/REVISION root controls",
+    "agente*/respuesta*/implementador* live root/CLI logs",
+    "output/perf-g11 ignored received snapshot and transient browser artifacts"
+  )
+}
+[IO.File]::WriteAllText(
+  (Join-Path $PSScriptRoot "manifiesto-final.json"),
+  (($document | ConvertTo-Json -Depth 6) + "`n"),
+  [Text.UTF8Encoding]::new($false)
+)
+Write-Output "manifest_entries=$($entries.Count)"
