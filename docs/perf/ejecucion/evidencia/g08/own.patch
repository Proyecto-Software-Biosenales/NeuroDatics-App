+def test_onset_capacity_bounds_entries_from_excess_projects(monkeypatch):
+    small = metadata._BoundedTTLCache(max_items=2, ttl_seconds=300)
+    monkeypatch.setattr(metadata, "_onsets", small)
+    for project in ("p1", "p2", "p3"):
