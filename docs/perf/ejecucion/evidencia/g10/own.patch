+    blocks = {item["visualization_id"]: item for item in payload["statistics"]}
+    assert blocks["pupil"]["status"] == "ok"
+    assert blocks["gsr"]["status"] == "error"
+    assert blocks["gsr"]["error"] == "computation_failed"
