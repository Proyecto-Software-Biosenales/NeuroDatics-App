# NeuroDatics backend environment variables
# Copy to backend/.env for a local backend; never commit real secrets.
# Defaults follow Settings. Database, secret, auth-store path and callbacks
# below are explicit local examples. Root Docker Compose uses root .env.example.
# External production PostgreSQL URLs require sslmode=require or stricter.

# Runtime
APP_ENV=development
DEBUG=false
APP_NAME=NeuroDatics API

# Database and readiness
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/neurodatics
READINESS_TIMEOUT_SECONDS=3.0
NETWORK_PREFLIGHT_TIMEOUT_SECONDS=10.0

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/authorize
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback
GOOGLE_DRIVE_OAUTH_STATE_TTL_SECONDS=600

# Authentication
# Replace with a unique random secret before production or sharing.
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=neurodatics-backend
AUTH_ACCESS_TOKEN_EXP_MINUTES=20160
AUTH_USER_STORE_PATH=./data/auth_users.json

# Browser access
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Drive
GOOGLE_APPLICATION_CREDENTIALS=
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_FOLDER_ID=
# Legacy forwarded key retained for compatibility with the shipped release.
GDRIVE_HTTP_TIMEOUT_SECONDS=300
GDRIVE_REQUEST_RETRIES=5
PROJECT_ZIP_MAX_SIZE_MB=500
INGESTION_SAVE_ORIGINAL_ZIP=true

# Folder sync (empty disables the sync endpoints)

# ZIP decompression guards
PROJECT_ZIP_MAX_UNCOMPRESSED_MB=2000
PROJECT_ZIP_MAX_ENTRY_UNCOMPRESSED_MB=600
PROJECT_ZIP_MAX_ENTRIES=20000
PROJECT_ZIP_MAX_COMPRESSION_RATIO=100.0

# Upload throttling
UPLOAD_MAX_CONCURRENT_PER_USER=1
UPLOAD_MAX_CONCURRENT_GLOBAL=4
UPLOAD_MIN_SECONDS_BETWEEN_UPLOADS=5.0

# Redis
REDIS_URL=redis://localhost:6379
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=3.0
REDIS_SOCKET_TIMEOUT_SECONDS=3.0
# RQ uses blocking reads; set none to disable the worker socket timeout.

# Analytics and media caches
PARQUET_CACHE_DIR=/data/parquet_cache
PARQUET_CACHE_TTL_HOURS=4
ANALYTICS_REDIS_TTL_SECONDS=900
IMAGE_CACHE_DIR=/data/image_cache
VIDEO_CACHE_DIR=/data/video_cache
VIDEO_FRAME_CACHE_DIR=/data/video_frame_cache
PARQUET_CACHE_KEEP_PREVIOUS_GENERATIONS=1
PARQUET_CACHE_PRUNE_MAX_REMOVALS=32
ANALYTICS_REDIS_STALE_GENERATION_MAX_DELETIONS=5000

# Media cache limits
MEDIA_CACHE_MAX_BYTES=2147483648
MEDIA_CACHE_MAX_AGE_HOURS=72
MEDIA_CACHE_PRUNE_MAX_REMOVALS=500

# Optional process-level proxy settings (read by HTTP libraries, not Settings).
# Uncomment only when required by your network; credentials stay server-side.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,::1,backend,worker,db,redis

# JOB_TIMEOUT and JOB_RESULT_TTL are absent: the current worker does not
# read them and no active producer enqueues the placeholder ZIP task.
