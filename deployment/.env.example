# Configuración local. El instalador completa los secretos vacíos.
# El responsable puede suministrar un .env ya configurado con la entrega.
FRONTEND_PORT=3000
APP_ENV=production
POSTGRES_DB=neurodatics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=
AUTH_JWT_SECRET=
# Credenciales del proyecto Google del equipo (tipo aplicación web).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/authorize
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GDRIVE_FOLDER_ID=
GDRIVE_UPLOAD_CONCURRENCY=4
INGESTION_SAVE_ORIGINAL_ZIP=false
BACKEND_MEM_LIMIT=2g
BACKEND_MEM_RESERVATION=512m
DEBUG=false
